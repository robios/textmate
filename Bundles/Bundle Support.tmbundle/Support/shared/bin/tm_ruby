#!/bin/sh

# Resolves the ruby that runs bundle items. The compatibility names bundles put
# in their shebangs — ruby18, ruby20 — are thin forwards to this, so there is a
# single place to repair when what is underneath moves, and so the names cannot
# drift into searching for different interpreters.
#
# Resolution order is: an explicit TM_RUBY, else the system ruby. Nothing is
# searched for beyond that — not Homebrew, not a version manager, and above all
# not an interpreter downloaded on demand, which is what the old ruby18 shim
# did. TextMate cannot vouch for the version or the architecture of a ruby it
# went looking for on its own, and a command that fails at the door is easier to
# understand than one that fails halfway through in an unexpected dialect.
#
# Apple has deprecated the system ruby, so it may one day not be there. That is
# the day this file, and only this file, has to change.
#
# Whether rubygems stays on is not decided here. It is a question about the name
# in the shebang — what bundle items written against it may already require —
# rather than about which interpreter is underneath, so each shim passes its own
# answer as the first argument. Called with no answer the choice is off, since
# what this runs is bundle items and rubygems is most of a bare ruby's startup.

gems=off
case ${1:-} in
	--tm-rubygems=on)  gems=on;  shift ;;
	--tm-rubygems=off) gems=off; shift ;;
esac

if [ -n "$TM_RUBY" ]; then
	# TM_RUBY naming one of our own shims would go in circles: the shim forwards
	# here and here would run the shim. ‘ruby18’ was a real choice of interpreter
	# once, so it can be left over in a .tm_properties from when it meant one,
	# and the Ruby bundle takes TM_RUBY as a bare command name.
	case ${TM_RUBY##*/} in
		ruby18|ruby20|tm_ruby)
			echo >&2 "${0##*/}: TM_RUBY is set to ‘$TM_RUBY’, which is one of TextMate’s own ruby shims rather than an interpreter. Set it to a ruby, or unset it to use the system one."
			exit 1
			;;
	esac

	# A ruby someone named comes with the gems they installed for it.
	RUBY=$TM_RUBY
	gems=on
else
	RUBY=/usr/bin/ruby

	# A ruby named in TM_RUBY comes with whatever environment the user set up
	# for it. The system one is only ever asked to run bundle items, and a
	# RUBYOPT or load path inherited from a shell configured for a different
	# install breaks them in a way that is near impossible to see from inside
	# a command.
	unset RUBYOPT RUBYLIB GEM_HOME

	# Explaining this on stderr and failing is the whole of it. TextMate shows
	# the error itself for any status outside 0 and 200–208, so raising our own
	# $DIALOG alert as well would say the same thing twice, and outside TextMate
	# stderr is the only place anyone would look.
	if [ ! -x "$RUBY" ]; then
		echo >&2 "${0##*/}: No ruby interpreter is available at $RUBY, so this command cannot run. Set TM_RUBY to one if you have another."
		exit 1
	fi
fi

# Ruby 1.9 retired -K. Current ruby prints ‘-K is specified; it is for 1.8
# compatibility’ on stderr — which reaches the user whenever the command shows
# HTML or a tooltip — and -KA is worse than noise: it forces the external
# encoding to ASCII-8BIT, while every -K in a bundle meant UTF-8, which the
# locale from Default.tmProperties already provides. So drop K and its code
# letter from leading option clusters (61 shebangs across the shipped bundles
# say -KU or -wKU; one says -KA). Filtering stops at the first non-option
# argument, and never touches anything with a slash, so script paths and our
# own -r below are safe. No subshells: this runs on every command invocation.
n=$#
i=0
filtering=1
while [ $i -lt $n ]; do
	i=$((i+1))
	arg=$1
	shift
	if [ -n "$filtering" ]; then
		case $arg in
			--)      filtering= ;;
			-*/*)    ;;
			-*K*)
				# Only a real kcode form: every letter before the K must be a
				# flag that takes no argument, or the K belongs to an option
				# argument (-IKlib, -rKfoo) and must pass through untouched.
				# The letter after the K is consumed only when it is a kcode.
				prefix=${arg%%K*}
				rest=${arg#*K}
				case ${prefix#-} in
					*[!acdlnpsSvwy]*) ;;
					*)
						case $rest in
							[aAeEnNsSuU]*) rest=${rest#?} ;;
						esac
						arg="$prefix$rest"
						[ "$arg" = "-" ] && continue
						;;
				esac
				;;
			-*)      ;;
			*)       filtering= ;;
		esac
	fi
	set -- "$@" "$arg"
done

# -r needs an absolute path: ruby resolves a relative one against the load path
# rather than the working directory, so ‘bin/ruby18 script.rb’ would fail to
# find the guard. Expanded without a subshell, since this runs per command.
case "$0" in
	/*) dir="${0%/*}"           ;;
	*)  dir="$PWD/${0%/*}"      ;;
esac

if [ "$gems" = on ]; then
	exec "$RUBY" -r"$dir/../private/ruby_runtime.rb" "$@"
else
	exec "$RUBY" --disable-gems -r"$dir/../private/ruby_runtime.rb" "$@"
fi
