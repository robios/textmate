#!/bin/sh

# Compatibility shim for bundle items with a ruby20 shebang (HTML, JSON, Math,
# Source and Hyperlink Helper use it).
#
# It used to glob /System/Library/Frameworks/Ruby.framework/Versions/2.* and run
# the first hit. That is the same interpreter /usr/bin/ruby leads to, so the
# glob was a second place to fix on the day the system ruby goes away. It now
# forwards to bin/tm_ruby like ruby18 does.
#
# Unlike ruby18 it keeps rubygems. This name has never been without it, and it
# is a public one: it sits in Bundle Support's shared bin/, so bundles we have
# never seen are free to write it above something that requires a gem. Saving
# them a slower start is not worth a LoadError they cannot have anticipated.

case "$0" in
	/*) dir="${0%/*}"           ;;
	*)  dir="$PWD/${0%/*}"      ;;
esac

exec "$dir/tm_ruby" --tm-rubygems=on "$@"
