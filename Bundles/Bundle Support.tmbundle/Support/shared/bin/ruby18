#!/bin/sh

# Compatibility shim for bundle items written against ruby 1.8.
#
# It used to download a 2012 build of ruby 1.8.7 from archive.textmate.org and
# run that. Those binaries are x86_64-only, so every command with a ruby18
# shebang — 43 bundles’ worth — depended on Rosetta 2. The name is kept because
# it is what the shebangs say, and because a shim reaches bundles we do not ship
# as well as the ones we do.
#
# Which ruby that is, the environment it runs with, and the -K filtering ruby
# 1.9 made necessary all belong to bin/tm_ruby, so that the compatibility names
# cannot come to mean different interpreters.
#
# What stays here is what is true of this name and not of the others: nothing
# reached through a ruby18 shebang has had rubygems since the shim stopped
# downloading its own interpreter, and disabling it is most of the reason a
# bundle command starts in 20 ms rather than 80.

case "$0" in
	/*) dir="${0%/*}"           ;;
	*)  dir="$PWD/${0%/*}"      ;;
esac

exec "$dir/tm_ruby" --tm-rubygems=off "$@"
