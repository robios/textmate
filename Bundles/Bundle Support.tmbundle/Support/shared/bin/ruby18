#!/bin/sh

# Compatibility shim for bundle items written against ruby 1.8.
#
# It used to download a 2012 build of ruby 1.8.7 from archive.textmate.org and
# run that. Those binaries are x86_64-only, so every command with a ruby18
# shebang — 43 bundles’ worth — depends on Rosetta 2. This runs a current ruby
# instead. The name is kept because it is what the shebangs say, and because a
# shim reaches bundles we do not ship as well as the ones we do.
#
# --disable-gems lives here rather than in each shebang: it makes startup
# roughly three times faster (rubygems is most of a bare ruby's launch cost),
# and splitting shebang arguments is Darwin-specific behaviour we would rather
# not rely on.
#
# This resolves the system ruby, which Apple has deprecated. Replacing that
# with a runtime TextMate itself ships is phase 3 of the bundle runtime plan;
# when it lands, this shim and bin/ruby20 both point at that resolver instead.
# There is deliberately no fallback to downloading an interpreter.

RUBY=/usr/bin/ruby

if [ ! -x "$RUBY" ]; then
	message="No ruby interpreter is available at $RUBY, so this command cannot run."
	echo >&2 "ruby18: $message"
	if [ -n "$DIALOG" ]; then
		"$DIALOG" alert --title "Unable to Run Command" --body "$message" --button1 "OK" >/dev/null 2>&1
	fi
	exit 1
fi

# Ruby 1.9 retired -K. Current ruby prints ‘-K is specified; it is for 1.8
# compatibility’ on stderr — which reaches the user whenever the command shows
# HTML or a tooltip — and -KA is worse than noise: it forces the external
# encoding to ASCII-8BIT, while every -K in a bundle meant UTF-8, which the
# locale from Default.tmProperties already provides. So drop K and its code
# letter from leading option clusters (61 shebangs across the shipped bundles
# say -KU or -wKU; one says -KA). Filtering stops at the first non-option
# argument, and never touches anything with a slash, so script paths and our
# own -r below are safe. No subshells: this runs on every command invocation.
n=$#
i=0
filtering=1
while [ $i -lt $n ]; do
	i=$((i+1))
	arg=$1
	shift
	if [ -n "$filtering" ]; then
		case $arg in
			--)      filtering= ;;
			-*/*)    ;;
			-*K*)
				# Only a real kcode form: every letter before the K must be a
				# flag that takes no argument, or the K belongs to an option
				# argument (-IKlib, -rKfoo) and must pass through untouched.
				# The letter after the K is consumed only when it is a kcode.
				prefix=${arg%%K*}
				rest=${arg#*K}
				case ${prefix#-} in
					*[!acdlnpsSvwy]*) ;;
					*)
						case $rest in
							[aAeEnNsSuU]*) rest=${rest#?} ;;
						esac
						arg="$prefix$rest"
						[ "$arg" = "-" ] && continue
						;;
				esac
				;;
			-*)      ;;
			*)       filtering= ;;
		esac
	fi
	set -- "$@" "$arg"
done

# -r needs an absolute path: ruby resolves a relative one against the load path
# rather than the working directory, so ‘bin/ruby18 script.rb’ would fail to
# find the guard. Expanded without a subshell, since this runs per command.
case "$0" in
	/*) dir="${0%/*}"           ;;
	*)  dir="$PWD/${0%/*}"      ;;
esac

exec "$RUBY" --disable-gems -r"$dir/../private/ruby_runtime.rb" "$@"
